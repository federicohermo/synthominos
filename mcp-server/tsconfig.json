{
  // Typecheck del server. NO compila: `noEmit` es la decisión, no un descuido —
  // node 22.18 corre los `.ts` quitando los tipos, así que no hay `dist/` que
  // pueda quedar viejo (D3 del plan).
  "compilerOptions": {
    "target": "ES2023",
    // `DOM` es contraintuitivo y por eso está escrito: el server no toca el DOM,
    // pero typechequea la cadena `playback/audio/scheduler.ts → playback/audio/voice.ts`, que
    // declara `BaseAudioContext`, `AudioNode` y `OscillatorType`. Sin `DOM` son
    // 8 errores TS2304. En runtime nada de eso existe: los tipos se borran y
    // `collectHits` es aritmética.
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // Los specifiers llevan `.ts` explícito: es lo que node necesita para
    // resolverlos sin build.
    "allowImportingTsExtensions": true,
    // La garantía que el type-stripping de node necesita: sin `enum` ni
    // parameter properties, nada que borrar tipos no alcance a resolver.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
