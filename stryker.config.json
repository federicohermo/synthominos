{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "The seven modules of src/ that `mutate` leaves out by name are covered only in Chromium, and Stryker cannot run the browser project. Do not add an exclusion to make a mutant go away.",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.d.ts",
    "!src/board-editing/use-input.ts",
    "!src/board-fit/use-grid.ts",
    "!src/panels/use-drag.ts",
    "!src/playback/engine.ts",
    "!src/playback/playhead-loop.ts",
    "!src/playback/use-engine.ts",
    "!src/spectrum/spectrum-loop.ts",
    ".spec-anchored/*.ts",
    "!.spec-anchored/spec-anchored.ts"
  ],
  "ignorePatterns": [".claude/worktrees", ".agent-runs", "dist", "coverage", ".vercel"],
  "reporters": ["clear-text", "progress", "json"],
  "clearTextReporter": { "logTests": false, "reportTests": false },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "dryRunTimeoutMinutes": 30,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp"
}
