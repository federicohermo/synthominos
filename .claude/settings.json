{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".agents/scripts/hook.ts",
              "claude"
            ],
            "timeout": 10,
            "statusMessage": "Verificando la rama y los worktrees…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/scripts/lint-al-cerrar.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Linteando lo que cambió…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/scripts/lint-al-cerrar.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Linteando lo que cambió…"
          }
        ]
      }
    ]
  }
}
