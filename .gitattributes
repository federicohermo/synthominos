# A .sh file is checked out with LF even when core.autocrlf is true: with CRLF the shebang reads
# with a carriage return stuck to the name of the interpreter, and fails with "bad interpreter".
*.sh text eol=lf

# A file that a script writes with `\n`, one entry per line. With `core.autocrlf=true`, a checkout
# on Windows would leave it with CRLF, and the first write would rewrite every line and not the
# one that changed. The format exists to give a diff of one line.
specs/mapa.json text eol=lf
